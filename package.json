{
  "name": "ngx-locatorjs",
  "version": "0.5.1",
  "description": "LocatorJs open-in-editor tools for Angular projects",
  "keywords": [
    "angular",
    "component",
    "devtools",
    "locatorjs",
    "open-in-editor"
  ],
  "homepage": "https://github.com/Ea-st-ring/ngx-locator#readme",
  "bugs": {
    "url": "https://github.com/Ea-st-ring/ngx-locator/issues"
  },
  "license": "MIT",
  "author": "antepost24",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ea-st-ring/ngx-locator.git"
  },
  "bin": {
    "locatorjs-config": "dist/node/config-setup.js",
    "locatorjs-open-in-editor": "dist/node/file-opener.js",
    "locatorjs-scan": "dist/node/cmp-scan.js",
    "ngx-locatorjs": "dist/node/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "dist/browser/index.js",
  "types": "dist/browser/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "default": "./dist/browser/index.js"
    },
    "./auto": {
      "types": "./dist/browser/auto.d.ts",
      "import": "./dist/browser/auto.js",
      "default": "./dist/browser/auto.js"
    }
  },
  "scripts": {
    "build": "npm run build:browser && npm run build:node",
    "build:browser": "tsc -p tsconfig.browser.json",
    "build:node": "tsc -p tsconfig.node.json",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "test": "node --test",
    "test:ci": "npm run build && npm test",
    "test:angular:e2e": "node scripts/angular-e2e-matrix.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "publish:github": "node scripts/publish-github.mjs"
  },
  "dependencies": {
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@types/node": "^18.18.0",
    "oxfmt": "^0.35.0",
    "playwright": "^1.61.0",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "typescript": ">=4.2"
  },
  "engines": {
    "node": "18 || 20 || >=22"
  }
}
